# Copy to .env for local development. On Render these go in Environment.
# Never commit real keys.

# Required for live match data - https://cricketdata.org (free tier ~100 req/day)
CRICKETDATA_API_KEY=

# Required for AI synthesis - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=*
CRICLYSIS_DATA_DIR=../web/data
CACHE_TTL_LIVE=60
CACHE_TTL_ANALYSIS=300
RATE_LIMIT_PER_MIN=30
LOG_LEVEL=INFO
